{
  "name": "gpgfrontend",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // workers_dev enables the <name>.<account>.workers.dev staging URL.
  // Set to false once gpgfrontend.bktus.com is confirmed working.
  "workers_dev": true,
  "preview_urls": false
}
