---
// Download boxes, read live from the signed update index:
//   current  the newest release, with one button for the visitor's system;
//   older    the newest release of every other series that still gets fixes;
//   testing  the test versions there are right now (release candidates,
//            betas, the nightly build), with a picker.
// What counts as which comes from the index alone (downloads/offers.ts), so
// no version is written here. Without JavaScript, or if a request fails,
// only the fallback text shows. While the data loads, a placeholder shows.
interface Props {
  show: "current" | "older" | "testing";
}
const { show } = Astro.props;
const INDEX_URL = "https://update.bktus.com/gpgfrontend/v1/index.json";
const GITHUB_RELEASES = "https://github.com/saturneric/GpgFrontend/releases";
const GITHUB_LATEST = `${GITHUB_RELEASES}/latest`;
const MIRROR = "https://ftp.bktus.com/GpgFrontend/";
const LOADING = {
  current: "Finding the right download for your computer…",
  older: "Loading older versions…",
  testing: "Loading test versions…",
}[show];
---

<div class="dl-downloads not-content" data-index={INDEX_URL} data-show={show}>
  <div class="dl-loading" hidden>
    <span class="dl-skel dl-skel-button"></span>
    <span class="dl-skel dl-skel-line"></span>
    <span class="dl-skel dl-skel-line dl-skel-short"></span>
    <p class="dl-loading-text" role="status">{LOADING}</p>
  </div>
  {
    show === "current" ? (
      <p class="dl-status" data-fallback>
        <span data-slow hidden>Taking long? </span>
        Download the latest version from <a href={GITHUB_LATEST}>GitHub</a>,
        or get the same files from the <a href={MIRROR}>mirror site</a>.
      </p>
    ) : show === "older" ? (
      <p class="dl-status" data-fallback>
        The older versions can't be shown here. You can find them on{" "}
        <a href={GITHUB_RELEASES}>GitHub</a> or the{" "}
        <a href={MIRROR}>mirror site</a>.
      </p>
    ) : (
      <p class="dl-status" data-fallback>
        The test versions can't be shown here. You can find them in the{" "}
        <a href={INDEX_URL}>build index</a>.
      </p>
    )
  }
  <div class="dl-result" hidden></div>
</div>

<script>
  import {
    buildUrl,
    detect,
    details,
    isRelease,
    MAC_CHIP,
    macMajor,
    offers,
    order,
    pick,
    pickMac,
    sha256Hex,
    size,
    variant,
    type Artifact,
    type Offer,
    type OfferKind,
    type Offers,
    type Visitor,
  } from "./downloads/offers";

  const GETTING_STARTED = "/overview/getting-started/";
  // The same release files are also kept on GitHub and on the mirror site.
  const GITHUB_TAG = "https://github.com/saturneric/GpgFrontend/releases/tag/v";
  const MIRROR_BASE = "https://ftp.bktus.com/GpgFrontend/v";
  const HOW_TO_RELEASE = "/appendix/code-binary-verify/#check-a-stable-release";
  const HOW_TO_BUILD = "/appendix/code-binary-verify/#check-a-test-build";

  const SYSTEMS = [
    ["windows", "Windows"],
    ["macos", "macOS"],
    ["linux", "Linux"],
    ["android", "Android"],
  ];

  const SAME_KEYS =
    "It uses the same keys and settings as your everyday GpgFrontend, so " +
    "back up your keys first.";

  // Everything that differs between the kinds of download, in one place.
  type KindText = {
    eyebrow: (o: Offer) => string;
    // What this one is, for the picker of test versions.
    pickLabel: (o: Offer) => string;
    button: (o: Offer, target: string, many: boolean) => string;
    caution?: (o: Offer) => string;
    // What there is none of, when a system has no file.
    noun: string;
  };
  const KIND: Record<OfferKind, KindText> = {
    stable: {
      eyebrow: () => "Latest version",
      pickLabel: (o) => o.version,
      button: (_o, t, many) =>
        many ? `Download for ${t}` : `Download GpgFrontend for ${t}`,
      noun: "version",
    },
    line: {
      eyebrow: (o) => `Series ${o.series}`,
      pickLabel: (o) => o.version,
      button: (o, t) => `Download ${o.version} for ${t}`,
      noun: "version",
    },
    rc: {
      eyebrow: () => "Release candidate",
      pickLabel: (o) => `Release candidate ${o.version}`,
      button: (_o, t) => `Download release candidate for ${t}`,
      caution: () =>
        "Early test version of the next feature release. It may have " +
        `bugs. ${SAME_KEYS}`,
      noun: "release candidate",
    },
    beta: {
      eyebrow: (o) => `Beta of ${o.series}`,
      pickLabel: (o) => `Beta of ${o.series}`,
      button: (_o, t) => `Download beta for ${t}`,
      caution: (o) =>
        `Test build of the next fix release of ${o.series}. It may have ` +
        `bugs. ${SAME_KEYS}`,
      noun: "beta",
    },
    nightly: {
      eyebrow: () => "Nightly build",
      pickLabel: () => "Nightly build",
      button: (_o, t) => `Download nightly build for ${t}`,
      caution: () =>
        "Automatic build of the newest code. It can be broken. It runs as " +
        "a separate app, GpgFrontend Testing, with its own keys and settings.",
      noun: "nightly build",
    },
  };

  // Everything the box needs to draw itself again for another system.
  type Ctx = {
    offer: Offer;
    d: any;
    artifacts: Artifact[];
    url: (path: unknown) => string | null;
    hero: HTMLElement;
  };

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    cls?: string,
    ...kids: (Node | string)[]
  ): HTMLElementTagNameMap[K] {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    e.append(...kids);
    return e;
  }

  function link(href: string, text: string, cls?: string): HTMLAnchorElement {
    const a = el("a", cls, text);
    a.href = href;
    return a;
  }

  const SVG = "http://www.w3.org/2000/svg";
  function icon(d: string, cls = "dl-icon"): SVGSVGElement {
    const svg = document.createElementNS(SVG, "svg");
    svg.setAttribute("viewBox", "0 0 24 24");
    svg.setAttribute("aria-hidden", "true");
    svg.setAttribute("class", cls);
    const path = document.createElementNS(SVG, "path");
    path.setAttribute("d", d);
    svg.append(path);
    return svg;
  }
  const ICON_DOWNLOAD = "M12 3v12m0 0-5-5m5 5 5-5M4 19h16";
  const ICON_SHIELD = "M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6l-7-3Zm-3 9 2 2 4-4";

  // What to do once the file is on the computer, in three short steps.
  const STEPS: Record<string, string[]> = {
    windows: [
      "Open the file you downloaded.",
      "Accept the license, then click Next until it is installed.",
      "Open GpgFrontend from the new shortcut on your desktop.",
    ],
    macos: [
      "Open the file you downloaded.",
      "Drag GpgFrontend into the Applications folder.",
      "Open GpgFrontend from your Applications folder.",
    ],
    linux: [
      "Right-click the file you downloaded and open Properties.",
      "Under Permissions, allow the file to run as a program.",
      "Double-click the file to start GpgFrontend.",
    ],
  };

  function isPlainVersion(version: string): boolean {
    return /^\d+\.\d+\.\d+$/.test(version);
  }

  // The same release on GitHub and on the mirror site, for when the main
  // download is slow or blocked, or cannot be shown.
  function backupLinks(p: HTMLElement, version: string) {
    p.append(
      link(GITHUB_TAG + version, "GitHub"),
      " or the ",
      link(`${MIRROR_BASE}${version}/`, "mirror site"),
      ".",
    );
  }

  function systemName(os: string): string {
    return SYSTEMS.find(([id]) => id === os)?.[1] ?? os;
  }

  function formatDate(iso: string, utc = false): string | null {
    const date = new Date(iso);
    if (Number.isNaN(date.getTime())) return null;
    return date.toLocaleDateString(undefined, {
      year: "numeric",
      month: "short",
      day: "numeric",
      ...(utc ? { timeZone: "UTC" } : {}),
    });
  }

  // The buttons for this visitor: one, or one per Mac chip when the
  // browser does not say which chip the Mac has.
  function choicesFor(ctx: Ctx, v: Visitor): [Artifact, string][] {
    const out: [Artifact, string][] = [];
    if (v.os === "macos") {
      const chips =
        v.arch === "arm" ? ["arm64"] : v.arch === "x86" ? ["x86_64"] : ["arm64", "x86_64"];
      for (const arch of chips) {
        const a = pickMac(ctx.artifacts, v, arch);
        if (a) out.push([a, chips.length > 1 ? MAC_CHIP[arch] : "Mac"]);
      }
    } else if (v.os) {
      const best = pick(ctx.artifacts, v);
      if (best) out.push([best, systemName(best.os)]);
    }
    return out.filter(([a]) => ctx.url(a.path));
  }

  // Why there is no button, and what to do instead.
  function noChoiceMessage(ctx: Ctx, v: Visitor): string {
    const pickOther = "Pick the computer you want it on:";
    const has = (os: string) => ctx.artifacts.some((a) => a.os === os);
    switch (v.os) {
      case "ios":
        return `GpgFrontend does not run on iPhone or iPad. ${pickOther}`;
      case "android":
        if (!has("android")) {
          return isRelease(ctx.offer.kind)
            ? `There is no Android version for everyday use yet. ${pickOther}`
            : `There is no ${KIND[ctx.offer.kind].noun} for Android right now. ${pickOther}`;
        }
        break;
      case "macos": {
        const mins = ctx.artifacts
          .filter((a) => a.os === "macos")
          .map(macMajor)
          .filter((m) => m > 0);
        if (mins.length && v.macos !== null) {
          return `Your Mac needs macOS ${Math.min(...mins)} or newer for this version.`;
        }
        break;
      }
      case null:
        return pickOther;
    }
    return `There is no download for ${systemName(v.os ?? "")} here right now. Pick another system:`;
  }

  // The top of the box: the button, what to do next, and a way to switch
  // to another system. Drawn again when the visitor picks another system.
  function renderHero(ctx: Ctx, v: Visitor) {
    const o = ctx.offer;
    const text = KIND[o.kind];
    const release = isRelease(o.kind);
    const hero = ctx.hero;
    hero.replaceChildren();

    if (text.caution) hero.append(el("p", "dl-caution", text.caution(o)));

    const choices = choicesFor(ctx, v);
    if (choices.length) {
      const row = el("div", "dl-choices");
      let hasSig = false;
      choices.forEach(([a, target], i) => {
        const cls =
          o.kind === "stable" && i === 0 ? "dl-button" : "dl-button secondary";
        const button = el("a", cls);
        button.href = ctx.url(a.path)!;
        button.title = a.name;
        button.append(
          icon(ICON_DOWNLOAD),
          text.button(o, target, choices.length > 1),
        );
        const meta = [
          "Free",
          size(a.size),
          a.os === "macos" && macMajor(a)
            ? `needs macOS ${macMajor(a)} or newer`
            : "",
        ]
          .filter(Boolean)
          .join(" · ");
        const metaEl = el("div", "dl-meta", meta);
        // Releases are signed file by file with the maintainer's OpenPGP key.
        const sig = release ? ctx.url(a.sig) : null;
        if (sig) {
          const s = link(sig, "OpenPGP signature");
          s.title = "Signature (.sig)";
          s.setAttribute("aria-label", `OpenPGP signature for ${a.name}`);
          metaEl.append(" · ", s);
          hasSig = true;
        }
        row.append(el("div", "dl-choice", button, metaEl));
      });
      hero.append(row);

      if (choices.length > 1 && v.os === "macos") {
        hero.append(
          el(
            "p",
            "dl-help",
            "Not sure which Mac you have? Open the Apple menu and choose " +
              "About This Mac. If it shows “Chip: Apple”, take the " +
              "first button. If it shows “Intel”, take the second.",
          ),
        );
      } else if (v.os === "macos") {
        // The browser named the chip; still offer the other one, in case
        // it guessed wrong.
        const otherArch = choices[0][0].arch === "arm64" ? "x86_64" : "arm64";
        const other = pickMac(ctx.artifacts, v, otherArch);
        const href = other && ctx.url(other.path);
        if (href) {
          const p = el("p", "dl-help");
          p.append(
            `Have a ${MAC_CHIP[otherArch]}? `,
            link(href, "Download that version instead"),
            ".",
          );
          hero.append(p);
        }
      }

      // The portable version for the same system, one click away.
      const portable = pick(ctx.artifacts, v, "portable");
      const portableHref = portable && ctx.url(portable.path);
      if (portable && portableHref) {
        const p = el("p", "dl-help dl-portable");
        const a = link(portableHref, "Download the portable version");
        a.title = portable.name;
        const bytes = size(portable.size);
        p.append(
          "Want to run it from a USB drive, without installing it? ",
          a,
          bytes ? ` (${bytes}).` : ".",
        );
        hero.append(p);
      }

      // What to do next, and how to check the file, folded away so the
      // button stays the main thing in the box.
      const steps = release ? STEPS[v.os ?? ""] : undefined;
      if (steps || hasSig) {
        const next = el("details", "dl-next");
        next.append(el("summary", undefined, "What to do after it downloads"));
        if (steps) {
          next.append(
            el("ol", undefined, ...steps.map((s) => el("li", undefined, s))),
          );
        }
        if (hasSig) {
          const check = el("p", "dl-next-help");
          check.append(
            "To make sure the file is genuine, also download its OpenPGP " +
              "signature. See ",
            link(HOW_TO_RELEASE, "How to check a download"),
            ".",
          );
          next.append(check);
        }
        const help = el("p", "dl-next-help");
        help.append("Need more help? See ", link(GETTING_STARTED, "Getting Started"), ".");
        next.append(help);
        hero.append(next);
      }
    } else {
      hero.append(el("p", "dl-hint", noChoiceMessage(ctx, v)));
    }

    // Other systems this download has files for.
    const others = SYSTEMS.filter(
      ([os]) =>
        !(choices.length && os === v.os) &&
        ctx.artifacts.some((a) => a.os === os && ctx.url(a.path)),
    );
    if (others.length) {
      const sw = el("div", "dl-switch");
      if (choices.length && v.os) {
        sw.append(el("span", undefined, `Not using ${systemName(v.os)}?`));
      }
      for (const [os, label] of others) {
        const b = el("button", "dl-switch-button", label);
        b.type = "button";
        b.addEventListener("click", () => {
          renderHero(ctx, { os, arch: null, macos: null });
          hero.querySelector<HTMLElement>(".dl-button, .dl-switch-button")?.focus();
        });
        sw.append(b);
      }
      hero.append(sw);
    }
  }

  // Every file, folded away, for people who know what they want.
  function renderMore(ctx: Ctx): HTMLElement {
    const release = isRelease(ctx.offer.kind);
    const more = el("details", "dl-more");
    more.append(el("summary", undefined, "More download options"));
    more.append(
      el(
        "p",
        "dl-more-intro",
        release
          ? "Portable versions, other computer types, and signature files."
          : "Portable versions and other computer types.",
      ),
    );
    let rows = 0;
    let sigs = 0;
    for (const [os, label] of SYSTEMS) {
      const items: HTMLElement[] = [];
      for (const a of ctx.artifacts.filter((a) => a.os === os).sort(order)) {
        const file = ctx.url(a.path);
        if (!file || typeof a.name !== "string") continue;
        const sig = ctx.url(a.sig);
        const row = el("li", "dl-row");
        const info = el(
          "div",
          "dl-row-info",
          el("span", "dl-row-name", variant(a)),
          el("span", "dl-row-meta", details(a)),
        );
        const actions = el("div", "dl-row-actions");
        const dl = el("a", "dl-row-download");
        dl.href = file;
        dl.title = a.name;
        dl.setAttribute("aria-label", `Download ${a.name}`);
        dl.append(icon(ICON_DOWNLOAD), el("span", "dl-row-label", "Download"));
        actions.append(dl);
        if (sig) {
          const s = link(sig, "", "dl-row-sig");
          s.title = "Signature (.sig)";
          s.setAttribute("aria-label", `Signature for ${a.name}`);
          s.append(icon(ICON_SHIELD));
          actions.append(s);
          sigs++;
        }
        row.append(info, actions);
        items.push(row);
        rows++;
      }
      if (items.length) {
        const group = el("section", "dl-group");
        group.append(
          el("h4", "dl-group-title", label),
          el("ul", undefined, ...items),
        );
        more.append(group);
      }
    }
    if (rows === 0) throw new Error("no files");

    if (sigs > 0) {
      const check = el("p", "dl-foot");
      check.append(
        "The shield icon is the file's signature. ",
        link(release ? HOW_TO_RELEASE : HOW_TO_BUILD, "How to check a download"),
        ".",
      );
      more.append(check);
    }

    if (release && isPlainVersion(ctx.offer.version)) {
      const p = el("p", "dl-foot");
      p.append("Download slow or blocked? Get the same files from ");
      backupLinks(p, ctx.offer.version);
      more.append(p);
    }

    more.append(...checksums(ctx));
    return more;
  }

  // The checksum lists, for checking files by hand. A release from the new
  // pipeline has the maintainer's list with its OpenPGP signature. Every
  // build also has the list GitHub's build made, signed with Sigstore; test
  // builds have only that one, and no file signatures.
  function checksums(ctx: Ctx): HTMLElement[] {
    const out: HTMLElement[] = [];
    const release = isRelease(ctx.offer.kind);
    const sums = ctx.url(ctx.d.sums);
    if (sums) {
      const foot = el("p", "dl-foot");
      foot.append("Checksum list: ", link(sums, "SHA256SUMS.txt"));
      const sumsSig = ctx.url(ctx.d.sums_sig);
      if (sumsSig) foot.append(" · ", link(sumsSig, "its signature"));
      out.push(foot);
    }
    const buildSums = ctx.url(ctx.d.build?.sums);
    const bundle = ctx.url(ctx.d.build?.bundle);
    if (buildSums && bundle) {
      const foot = el("p", "dl-foot");
      foot.append(
        release ? "Build checksum list: " : "To check these files: ",
        link(buildSums, "SHA256SUMS.txt"),
        " · ",
        link(bundle, "SHA256SUMS.txt.sigstore.json"),
      );
      if (!release) {
        foot.append(" · ", link(HOW_TO_BUILD, "How to check a test build"));
      }
      out.push(foot);
    }
    return out;
  }

  // One download, drawn into @p target: what it is, the button, every file.
  function render(target: HTMLElement, offer: Offer, d: any, v: Visitor) {
    const release = isRelease(offer.kind);

    // Header: what this is, which version, when it was made.
    const header = el("div", "dl-header");
    const title = el("div", "dl-title");
    title.append(
      el("span", "dl-eyebrow", KIND[offer.kind].eyebrow(offer)),
      el("code", "dl-version", offer.version),
    );
    header.append(title);
    const iso = release ? d.released_at : d.built_at;
    const date = typeof iso === "string" ? formatDate(iso) : null;
    if (date) {
      const time = el("time", "dl-date", `${release ? "Released" : "Built"} ${date}`);
      time.dateTime = new Date(iso).toISOString();
      header.append(time);
    }

    const ctx: Ctx = {
      offer,
      d,
      artifacts: Array.isArray(d.artifacts) ? d.artifacts : [],
      url: (path: unknown) => buildUrl(path, offer.kind),
      hero: el("div", "dl-hero"),
    };
    const more = renderMore(ctx);
    renderHero(ctx, v);
    target.replaceChildren(header, ctx.hero, more);
  }

  // ------------------------------------------------------------- loading

  // One index request and one visitor guess, shared by every box on the
  // page; each descriptor is fetched once.
  let indexPromise: Promise<Offers> | null = null;
  function getOffers(url: string): Promise<Offers> {
    indexPromise ??= fetch(url, { cache: "no-cache" }).then(async (r) => {
      if (!r.ok) throw new Error(`index: ${r.status}`);
      return offers(await r.json());
    });
    return indexPromise;
  }
  let visitorPromise: Promise<Visitor> | null = null;
  function visitor(): Promise<Visitor> {
    visitorPromise ??= detect();
    return visitorPromise;
  }
  const descriptors = new Map<string, Promise<any>>();
  function descriptor(o: Offer): Promise<any> {
    let p = descriptors.get(o.descriptor);
    if (!p) {
      p = (async () => {
        const url = buildUrl(o.descriptor, o.kind);
        if (!url) throw new Error("bad descriptor path");
        const res = await fetch(url);
        if (!res.ok) throw new Error(`descriptor: ${res.status}`);
        const raw = await res.arrayBuffer();
        // The index names the descriptor's hash; anything else is not shown.
        if ((await sha256Hex(raw)) !== o.sha256) {
          throw new Error("descriptor hash does not match the index");
        }
        return JSON.parse(new TextDecoder().decode(raw));
      })();
      p.catch(() => descriptors.delete(o.descriptor));
      descriptors.set(o.descriptor, p);
    }
    return p;
  }

  // Load and draw one offer into @p target, with a short loading line and,
  // if it fails, links to where else to find it.
  async function show(target: HTMLElement, o: Offer) {
    target.replaceChildren(
      el("p", "dl-loading-text", "Loading…"),
    );
    target.setAttribute("aria-busy", "true");
    try {
      render(target, o, await descriptor(o), await visitor());
    } catch (e) {
      console.warn(`${o.version} downloads unavailable:`, e);
      const p = el("p", "dl-hint", "This download can't be shown here. ");
      if (isRelease(o.kind) && isPlainVersion(o.version)) {
        p.append("Get it from ");
        backupLinks(p, o.version);
      }
      target.replaceChildren(p);
    } finally {
      target.setAttribute("aria-busy", "false");
    }
  }

  // What a supported older series still gets, in plain words.
  function lineStatus(o: Offer): string {
    if (o.status === "legacy") {
      const end = o.eol ? formatDate(o.eol, true) : null;
      return end ? `Security fixes only, until ${end}` : "Security fixes only";
    }
    return "Still gets fixes";
  }

  // One folded row per older series; its files load when it is opened.
  function renderOlder(out: HTMLElement, list: Offer[]) {
    if (!list.length) {
      out.append(
        el(
          "p",
          "dl-hint",
          "Right now, only the version at the top of this page still gets fixes.",
        ),
      );
      return;
    }
    for (const o of list) {
      const line = el("details", "dl-line");
      const summary = el(
        "summary",
        undefined,
        el("span", "dl-line-title", `GpgFrontend ${o.version}`),
        el("span", "dl-line-status", lineStatus(o)),
      );
      const body = el("div", "dl-line-body");
      line.append(summary, body);
      line.addEventListener("toggle", () => {
        if (line.open && !body.hasChildNodes()) void show(body, o);
      });
      out.append(line);
    }
  }

  // A picker over the test versions there are, and the chosen one below.
  function renderTesting(out: HTMLElement, list: Offer[]) {
    if (!list.length) {
      out.append(el("p", "dl-hint", "There is no test version right now."));
      return;
    }
    const body = el("div", "dl-pick-body");
    const buttons: HTMLButtonElement[] = [];
    const select = (i: number) => {
      buttons.forEach((b, j) => b.setAttribute("aria-pressed", String(i === j)));
      void show(body, list[i]);
    };
    if (list.length > 1) {
      const picker = el("div", "dl-switch dl-picker");
      picker.append(el("span", undefined, "Pick one:"));
      list.forEach((o, i) => {
        const b = el("button", "dl-switch-button", KIND[o.kind].pickLabel(o));
        b.type = "button";
        b.addEventListener("click", () => select(i));
        buttons.push(b);
        picker.append(b);
      });
      out.append(picker);
    }
    out.append(body);
    select(0);
  }

  async function load(root: HTMLElement, mode: string) {
    const all = await getOffers(root.dataset.index!);
    const out = root.querySelector<HTMLElement>(".dl-result")!;
    out.replaceChildren();
    if (mode === "older") return renderOlder(out, all.older);
    if (mode === "testing") return renderTesting(out, all.testing);
    // The main download keeps its fallback links when there is none.
    if (!all.current) throw new Error("no stable release in the index");
    render(out, all.current, await descriptor(all.current), await visitor());
  }

  type State = "loading" | "slow" | "done" | "failed";

  // Which part of the box shows: the placeholder, the fallback links, or
  // the finished list.
  function setState(root: HTMLElement, state: State) {
    const loading = root.querySelector<HTMLElement>(".dl-loading")!;
    const fallback = root.querySelector<HTMLElement>("[data-fallback]")!;
    const slow = fallback.querySelector<HTMLElement>("[data-slow]");
    const result = root.querySelector<HTMLElement>(".dl-result")!;
    loading.hidden = state !== "loading" && state !== "slow";
    fallback.hidden = state === "loading" || state === "done" || (state === "slow" && !slow);
    if (slow) slow.hidden = state !== "slow";
    result.hidden = state !== "done";
    root.setAttribute("aria-busy", String(state === "loading" || state === "slow"));
  }

  // After this long, also offer the fallback links, but keep waiting.
  const SLOW_MS = 8000;

  for (const root of document.querySelectorAll<HTMLElement>(
    ".dl-downloads",
  )) {
    const mode = root.dataset.show ?? "current";
    setState(root, "loading");
    let settled = false;
    const timer = setTimeout(() => {
      if (!settled) setState(root, "slow");
    }, SLOW_MS);
    load(root, mode)
      .then(() => setState(root, "done"))
      .catch((e) => {
        setState(root, "failed");
        console.warn(`${mode} download list unavailable:`, e);
      })
      .finally(() => {
        settled = true;
        clearTimeout(timer);
      });
  }
</script>

