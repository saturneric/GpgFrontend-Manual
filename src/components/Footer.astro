---
// The page footer: Starlight's own footer, then the site footer with the
// links that belong on every page. German law wants the legal notice link
// ("Impressum") on every page, so it lives here and not in the page content.
import Default from "@astrojs/starlight/components/Footer.astro";
import { Icon } from "@astrojs/starlight/components";

const GITHUB = "https://github.com/saturneric/GpgFrontend";

const groups = [
  {
    title: "Project",
    links: [
      { label: "Source Code", href: GITHUB },
      { label: "Security Policy", href: `${GITHUB}/security/policy` },
      { label: "Contact", href: "/overview/contact/" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Impressum", href: "/impressum/" },
      { label: "Privacy Policy", href: "/privacy/" },
      { label: "License (GPL-3.0)", href: `${GITHUB}/blob/main/COPYING` },
    ],
  },
];
---

<Default><slot /></Default>

<div class="site-footer">
  <div class="site-footer-about">
    <p class="site-footer-name">GpgFrontend</p>
    <p>A free, easy-to-use, cross-platform OpenPGP crypto tool.</p>
  </div>
  {
    groups.map(({ title, links }) => (
      <nav aria-label={title}>
        <p class="site-footer-title">{title}</p>
        <ul>
          {links.map(({ label, href }) => (
            <li>
              <a href={href}>
                {label}
                {href.startsWith("http") && (
                  <Icon name="external" size="0.85em" />
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))
  }
</div>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3.5rem;
    border-top: 1px solid var(--sl-color-hairline-light);
    padding-top: 1.75rem;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }

  .site-footer-about {
    flex: 1 1 14rem;
  }

  .site-footer-name {
    margin-bottom: 0.375rem;
    font-size: var(--sl-text-base);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .site-footer-title {
    margin-bottom: 0.625rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .site-footer ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
</style>
